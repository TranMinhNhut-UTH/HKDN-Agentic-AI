# mock = offline simulation; live = Gemini + real RSS, never fallback to mock
APP_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
HTTP_TIMEOUT=20
MAX_API_CALLS=16
MAX_STEPS=8
MAX_ROUNDS=2
DATA_DIR=data
REPORT_DIR=reports
# Separate credential for real YouTube comments. Not affected by APP_MODE.
YOUTUBE_API_KEY=
